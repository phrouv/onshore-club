<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        ROOT PARENT POM
        ================
        This is the top-level POM for the entire multi-module project.
        packaging=pom means this module produces NO JAR/WAR
    -->
    <groupId>com.onshore</groupId>
    <artifactId>onshore-microservice</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OnShore System</name>
    <description>OnShore GDS Microservices Parent</description>

    <!-- prerequisites had been marked deprecated for a long time (starting
       with Maven 3.0). The intention of prerequisites was to prevent maven plugins
       running with the wrong Maven versions. The best thing is to use Enforcer
       plugin. Unfortunately prerequisites is needed for "mvn versions:display-plugin-updates"
       command to work well. -->
    <prerequisites>
        <maven>${maven.version}</maven>
    </prerequisites>

    <!--
        MODULES
        =======
        Lists all child modules to include in the build.
        When you run "mvn clean install" from this directory, Maven will
        build these modules in dependency order automatically.

        NOTE: "cloud" is an aggregator module that itself contains
        service-registry, config-server, and api-gateway as sub-modules.
    -->
    <modules>
        <module>common-lib</module>
        <module>cloud</module>
        <module>services</module>
    </modules>

    <!--
        PROPERTIES
        ==========
        Centralized version numbers and build settings.
        Any child POM can reference these with ${property.name}.
        Change a version here → all children pick it up automatically.
    -->
    <properties>
        <!-- Java version for compilation -->
        <java.version>25</java.version>
        <maven.version>3.10.0</maven.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.plugin.validation>brief</maven.plugin.validation>
        <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>

        <!--
            Source encoding: prevents "platform default encoding" warnings.
            Without this, Maven uses your OS default encoding (e.g., Windows-1252 on Windows),
            which causes inconsistent builds across different developer machines.
        -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Framework versions — single source of truth -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <springdoc-openapi-bom.version>3.2.0</springdoc-openapi-bom.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <jjwt.version>0.13.0</jjwt.version>
        <swagger.version>3.0.0</swagger.version>

        <!-- Dependencies Versions -->
        <postgresql.version>42.7.14</postgresql.version>
        <razorpay-java.version>1.4.10</razorpay-java.version>
        <stripe-java.version>34.0.0</stripe-java.version>
        <twilio.version>13.1.0</twilio.version>
        <aws-sdk-bom.version>2.57.8</aws-sdk-bom.version>

        <!-- Plugins Versions -->
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <google-java-format.version>1.36.1</google-java-format.version>
        <git-build-hook-maven-plugin.version>3.6.0</git-build-hook-maven-plugin.version>
        <git-commit-id-maven-plugin.version>10.0.1</git-commit-id-maven-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
    </properties>

    <!--
        DEPENDENCY MANAGEMENT
        =====================
        Controls VERSIONS of dependencies, but does NOT add them.

        How it works:
        - You import Spring Boot and Spring Cloud BOMs (Bill of Materials) here
        - BOMs are like a "version catalog" — they list hundreds of compatible library versions
        - Child modules declare dependencies WITHOUT <version> tags
        - Maven looks up the version from these BOMs automatically
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM — manages versions for all spring-boot-starter-* dependencies -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM — manages versions for all spring-cloud-starter-* dependencies -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-bom</artifactId>
                <version>${jjwt.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc-openapi-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <dependency>
                <groupId>com.twilio.sdk</groupId>
                <artifactId>twilio</artifactId>
                <version>${twilio.version}</version>
            </dependency>

            <dependency>
                <groupId>com.razorpay</groupId>
                <artifactId>razorpay-java</artifactId>
                <version>${razorpay-java.version}</version>
            </dependency>

            <dependency>
                <groupId>com.stripe</groupId>
                <artifactId>stripe-java</artifactId>
                <version>${stripe-java.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!--
        BUILD / PLUGIN MANAGEMENT
        =========================
        Same concept as dependencyManagement, but for build plugins.

        pluginManagement defines plugin versions and DEFAULT configurations.
        Child modules can then use these plugins by just declaring the groupId:artifactId
        WITHOUT repeating the version or configuration.

        IMPORTANT: pluginManagement does NOT activate plugins — it only PRE-CONFIGURES them.
        Children must still declare the plugin in their own <build><plugins> section to use it.

        WHY is this needed?
        Since we use spring-boot-dependencies BOM (via <scope>import</scope>) instead of
        spring-boot-starter-parent as a direct <parent>, we lose the automatic plugin
        configuration that starter-parent provides. We must configure these ourselves.
    -->
    <build>
        <pluginManagement>
            <plugins>
                <!--
                    maven-compiler-plugin: Controls Java compilation settings.

                    Without this, Maven defaults to Java 1.8 source/target level,
                    which means your Java 17 features (records, sealed classes, etc.) won't compile.

                    <source> = what Java syntax version to accept during compilation
                    <target> = what bytecode version to generate in .class files
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <parameters>true</parameters>
                        <!-- JDK 23+ no longer runs annotation processors (Lombok) found on the classpath by default -->
                        <proc>full</proc>
                    </configuration>
                </plugin>
                <!--
                    spring-boot-maven-plugin: Packages a module as an executable Spring Boot JAR.

                    What it does:
                    - Repackages the JAR to include all dependencies inside it
                    - Adds a special launcher class so you can run it with "java -jar app.jar"
                    - Without this, you'd get a plain JAR that can't start on its own

                    ONLY runnable services should use this plugin (NOT libraries like common-lib).
                    Libraries should produce plain JARs that other modules depend on.

                    Version is defined here; children just reference the plugin without a version.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                    <configuration>
                        <from>
                            <platforms>
                                <platform>
                                    <architecture>amd64</architecture>
                                    <os>linux</os>
                                </platform>
                                <platform>
                                    <architecture>arm64</architecture>
                                    <os>linux</os>
                                </platform>
                            </platforms>
                        </from>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <googleJavaFormat>
                                <version>${google-java-format.version}</version>
                                <style>GOOGLE</style>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>apply</goal>
                            </goals>
                            <phase>compile</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.rudikershaw.gitbuildhook</groupId>
                    <artifactId>git-build-hook-maven-plugin</artifactId>
                    <version>${git-build-hook-maven-plugin.version}</version>
                    <configuration>
                        <installHooks>
                            <pre-commit>hooks/pre-commit.sh</pre-commit>
                        </installHooks>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>install</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>${git-commit-id-maven-plugin.version}</version>
                    <configuration>
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                        <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                        <generateGitPropertiesFile>true</generateGitPropertiesFile>
                        <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties
                        </generateGitPropertiesFilename>
                        <includeOnlyProperties>
                            <includeOnlyProperty>^git.build.(time|version)$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.id.(abbrev|full|time)$</includeOnlyProperty>
                            <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.user.email$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.message.short$</includeOnlyProperty>
                        </includeOnlyProperties>
                        <commitIdGenerationMode>full</commitIdGenerationMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>get-the-git-infos</id>
                            <goals>
                                <goal>revision</goal>
                            </goals>
                            <phase>initialize</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <version>${maven.version}</version>
                                        <message>Unfortunately, the correct maven version is not supported by your
                                            system
                                        </message>
                                    </requireMavenVersion>
                                    <requireJavaVersion>
                                        <version>${java.version}</version>
                                    </requireJavaVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.rudikershaw.gitbuildhook</groupId>
                <artifactId>git-build-hook-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
